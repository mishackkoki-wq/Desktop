# Copy to .env locally, then set the actual server-side Supabase credentials.
# Use the Secret key from Supabase Dashboard > Settings > API Keys.
# Keep this key server-side; never commit it or put it in Javascript/app.js.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_SECRET_KEY
SUPABASE_STATE_TABLE=lms_state
PORT=5000

# Public LMS URL included in learner approval emails.
APP_BASE_URL=http://127.0.0.1:5000

# SMTP settings used to deliver application approval and decline emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Chimera LMS <no-reply@example.com>
